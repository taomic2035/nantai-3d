{
  "name": "v1.0.0-tag-protection",
  "target": "tag",
  "source_type": "Repository",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v1.0.0"
      ],
      "exclude": []
